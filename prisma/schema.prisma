  codigo_tarea      String?
  codigo_sitio      String?
  nombre_sitio      String?
  elemento_red      String?
  estado            String?
  origen            String
  tipo_formulario   String?
  clave_origen      String
  combustible       String?
  tanque            String?
  litros_cargados   Decimal?  @db.Decimal(18, 3)
  nivel_antes       Decimal?  @db.Decimal(8, 3)
  nivel_final       Decimal?  @db.Decimal(8, 3)
  horometro         Decimal?  @db.Decimal(18, 3)
  ge_en_marcha      Boolean?
  fecha_evento      DateTime? @db.Timestamptz(6)
  ultima_edicion_el DateTime? @db.Timestamptz(6)
  sincronizado_el   DateTime  @default(now()) @db.Timestamptz(6)
  raw_data          Json      @default("{}")
  creado_bd         DateTime  @default(now()) @db.Timestamptz(6)
  actualizado_bd    DateTime  @default(now()) @db.Timestamptz(6)

  @@unique([formulario, origen, clave_origen], map: "uq_carga_combustible_ge")
  @@index([fecha_evento], map: "idx_cargas_ge_fecha")
  @@index([formulario], map: "idx_cargas_ge_formulario")
  @@index([origen], map: "idx_cargas_ge_origen")
  @@index([codigo_sitio], map: "idx_cargas_ge_sitio")
}

