model pendientes_visita {
  id                 BigInt    @id @default(autoincrement())
  formulario         String
  origen_fuente      String
  codigo_sitio       String?
  nombre_sitio       String?
  elemento_red       String?
  estado             String?
  grupo              String?
  indice             String?
  pregunta           String?
  respuesta          String?
  comentarios        String?
  posible_pendiente  Boolean?  @default(true)
  ultima_edicion_el  DateTime? @db.Timestamptz(6)
  ultima_edicion_por String?
  sincronizado_el    DateTime? @default(now()) @db.Timestamptz(6)
  clave_origen       String
  estado_pendiente   String    @default("PENDIENTE")

  @@unique([formulario, origen_fuente, clave_origen], map: "uq_pendientes_visita_sync")
  @@index([origen_fuente], map: "idx_pendientes_visita_origen")
  @@index([codigo_sitio], map: "idx_pendientes_visita_sitio")
}

/// FNET-owned assignment state. It intentionally has no foreign key to Sytex tables.
model task_assignments {
  id                      BigInt   @id @default(autoincrement())
  task_type               String
  task_code               String
  technician_primary      String
  technician_collaborator String
  assigned_at             DateTime @default(now()) @db.Timestamptz(6)
  assigned_by             String
  updated_at              DateTime @updatedAt @db.Timestamptz(6)
  active                  Boolean  @default(true)

  @@unique([task_type, task_code], map: "uq_fnet_task_assignment_task")
  @@index([task_type, active], map: "idx_fnet_task_assignment_active")
  @@map("task_assignments")
}

/// FNET-owned audit trail for changes to task_assignments.
model task_assignment_history {
  id                               BigInt   @id @default(autoincrement())
  task_type                        String
  task_code                        String
  previous_technician_primary      String?
  previous_technician_collaborator String?
  new_technician_primary           String
  new_technician_collaborator      String
  changed_at                       DateTime @default(now()) @db.Timestamptz(6)
  changed_by                       String

  @@index([task_type, task_code, changed_at], map: "idx_fnet_task_assignment_history_task")
  @@map("task_assignment_history")
}
