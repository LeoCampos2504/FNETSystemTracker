generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model app_users {
  id            String         @id @default(uuid()) @db.Uuid
  email         String         @unique
  name          String
  passwordHash  String         @map("password_hash")
  role          String
  technicianId  String?        @map("technician_id")
  coordinatorId String?        @map("coordinator_id")
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  sessions      app_sessions[]

  @@index([role, active], map: "idx_app_users_role_active")
  @@map("app_users")
}

model app_sessions {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  userId    String    @map("user_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      app_users @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt], map: "idx_app_sessions_expires_at")
  @@index([userId], map: "idx_app_sessions_user_id")
  @@map("app_sessions")
}

model app_login_attempts {
  keyHash         String   @id @map("key_hash") @db.VarChar(64)
  attemptCount    Int      @default(0) @map("attempt_count")
  windowStartedAt DateTime @default(now()) @map("window_started_at") @db.Timestamptz(6)

  @@index([windowStartedAt], map: "idx_app_login_attempts_window")
  @@map("app_login_attempts")
}

model mendel_transactions {
  id                    BigInt    @id @default(autoincrement())
  transactionId         String    @unique @map("transaction_id") @db.VarChar(80)
  transactionDate       DateTime  @map("transaction_date") @db.Timestamptz(6)
  confirmationDate      DateTime? @map("confirmation_date") @db.Timestamptz(6)
  userName              String?   @map("user_name") @db.VarChar(200)
  merchant              String?   @db.VarChar(250)
  totalAmount           Decimal   @map("total_amount") @db.Decimal(18, 2)
  currency              String    @db.VarChar(3)
  internationalAmount   Decimal?  @map("international_amount") @db.Decimal(18, 2)
  internationalCurrency String?   @map("international_currency") @db.VarChar(3)
  bankFee               Decimal?  @map("bank_fee") @db.Decimal(18, 2)
  budget                String?   @db.VarChar(200)
  budgetId              String?   @map("budget_id") @db.VarChar(100)
  paymentMethod         String?   @map("payment_method") @db.VarChar(100)
  transactionType       String?   @map("transaction_type") @db.VarChar(100)
  transactionStatus     String?   @map("transaction_status") @db.VarChar(100)
  referenceCode         String?   @map("reference_code") @db.VarChar(100)
  paymentOrigin         String?   @map("payment_origin") @db.VarChar(100)
  channel               String?   @db.VarChar(100)
  merchantCategory      String?   @map("merchant_category") @db.VarChar(150)
  transactionCategory   String?   @map("transaction_category") @db.VarChar(150)
  hasReceipt            Boolean?  @map("has_receipt")
  documentName          String?   @map("document_name") @db.VarChar(250)
  invoiceTotal          Decimal?  @map("invoice_total") @db.Decimal(18, 2)
  invoiceDifference     Decimal?  @map("invoice_difference") @db.Decimal(18, 2)
  receiptStatus         String?   @map("receipt_status") @db.VarChar(150)
  vat                   Decimal?  @db.Decimal(18, 2)
  grossIncomeTax        Decimal?  @map("gross_income_tax") @db.Decimal(18, 2)
  otherTaxes            Decimal?  @map("other_taxes") @db.Decimal(18, 2)
  exemptAmount          Decimal?  @map("exempt_amount") @db.Decimal(18, 2)
  nonTaxedAmount        Decimal?  @map("non_taxed_amount") @db.Decimal(18, 2)
  reconciliationStatus  String    @default("PENDING") @map("reconciliation_status") @db.VarChar(30)
  importedAt            DateTime  @default(now()) @map("imported_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  formReferences        mendel_form_references[]

  @@index([transactionDate], map: "idx_mendel_transactions_date")
  @@index([transactionStatus], map: "idx_mendel_transactions_status")
  @@index([receiptStatus], map: "idx_mendel_transactions_receipt_status")
  @@index([reconciliationStatus], map: "idx_mendel_transactions_reconciliation")
  @@index([userName], map: "idx_mendel_transactions_user")
  @@index([merchant], map: "idx_mendel_transactions_merchant")
  @@map("mendel_transactions")
}

model mendel_import_batches {
  id            BigInt   @id @default(autoincrement())
  fileHash      String   @map("file_hash") @db.VarChar(64)
  rowCount      Int      @map("row_count")
  insertedCount Int      @map("inserted_count")
  updatedCount  Int      @map("updated_count")
  importedBy    String   @map("imported_by") @db.Uuid
  importedAt    DateTime @default(now()) @map("imported_at") @db.Timestamptz(6)

  @@index([importedAt], map: "idx_mendel_import_batches_imported_at")
  @@map("mendel_import_batches")
}

model mendel_form_references {
  transactionId String             @map("transaction_id") @db.VarChar(80)
  formCode      String             @map("form_code") @db.VarChar(20)
  transaction   mendel_transactions @relation(fields: [transactionId], references: [transactionId], onDelete: Cascade, map: "fk_mendel_form_reference_transaction")

  @@id([transactionId, formCode], map: "pk_mendel_form_references")
  @@index([formCode], map: "idx_mendel_form_references_form")
  @@map("mendel_form_references")
}

model sytex_supply_imports {
  id                  String    @id @default(uuid()) @db.Uuid
  fileHash            String    @unique(map: "uq_sytex_supply_imports_hash") @map("file_hash") @db.VarChar(64)
  fileName            String    @map("file_name") @db.VarChar(250)
  answerCount         Int       @map("answer_count")
  formCount           Int       @map("form_count")
  sourceEditedFrom    String?   @map("source_edited_from")
  sourceEditedThrough String?   @map("source_edited_through")
  importedBy          String    @map("imported_by") @db.Uuid
  importedAt          DateTime  @default(now()) @map("imported_at") @db.Timestamptz(6)
  items               sytex_supply_import_items[]
  forms               sytex_supply_form_contexts[]
  maintenance         sytex_site_maintenance[]
  links               sytex_form_links[]
  states              sytex_form_states[]
  taskDates           sytex_task_dates[]
  siteAnswers         sytex_site_answers[]

  @@index([importedAt], map: "idx_sytex_supply_imports_date")
  @@map("sytex_supply_imports")
}

model sytex_supply_form_contexts {
  id          String @id @default(uuid()) @db.Uuid
  importId    String @map("import_id") @db.Uuid
  code        String
  type        String
  project     String
  siteCode    String @map("site_code")
  siteName    String @map("site_name")
  description String
  technicians Json
  import      sytex_supply_imports @relation(fields: [importId], references: [id], onDelete: Cascade, map: "fk_sytex_supply_form_contexts_import")
  @@unique([importId, code], map: "uq_sytex_supply_form_context")
  @@index([code], map: "idx_sytex_supply_form_context_code")
  @@map("sytex_supply_form_contexts")
}

model sytex_form_states {
  id       String    @id @default(uuid()) @db.Uuid
  importId String    @map("import_id") @db.Uuid
  code     String
  status   String
  planDate DateTime? @map("plan_date") @db.Date
  import   sytex_supply_imports @relation(fields: [importId], references: [id], onDelete: Cascade, map: "fk_sytex_form_states_import")
  @@unique([importId, code], map: "uq_sytex_form_state")
  @@index([code], map: "idx_sytex_form_state_code")
  @@map("sytex_form_states")
}

model sytex_task_dates {
  id          String    @id @default(uuid()) @db.Uuid
  importId    String    @map("import_id") @db.Uuid
  code        String
  subZone     String    @default("") @map("sub_zone")
  requestedOn DateTime? @map("requested_on") @db.Date
  startedOn   DateTime? @map("started_on") @db.Date
  finishedOn  DateTime? @map("finished_on") @db.Date
  import      sytex_supply_imports @relation(fields: [importId], references: [id], onDelete: Cascade, map: "fk_sytex_task_dates_import")
  @@unique([importId, code], map: "uq_sytex_task_dates")
  @@index([code], map: "idx_sytex_task_dates_code")
  @@map("sytex_task_dates")
}

model sytex_site_answers {
  id         String @id @default(uuid()) @db.Uuid
  importId   String @map("import_id") @db.Uuid
  formCode   String @map("form_code")
  siteCode   String @map("site_code")
  siteName   String @default("") @map("site_name")
  topic      String
  groupName  String @map("grupo")
  position   String @map("indice")
  question   String @map("pregunta")
  answer     String @map("respuesta")
  reportedAt String @default("") @map("reported_at")
  import     sytex_supply_imports @relation(fields: [importId], references: [id], onDelete: Cascade, map: "fk_sytex_site_answers_import")
  @@unique([importId, formCode, groupName, position], map: "uq_sytex_site_answers")
  @@index([siteCode], map: "idx_sytex_site_answers_site")
  @@index([formCode], map: "idx_sytex_site_answers_form")
  @@map("sytex_site_answers")
}

model sytex_form_links {
  id       String @id @default(uuid()) @db.Uuid
  importId String @map("import_id") @db.Uuid
  code     String
  link     String
  import   sytex_supply_imports @relation(fields: [importId], references: [id], onDelete: Cascade, map: "fk_sytex_form_links_import")
  @@unique([importId, code], map: "uq_sytex_form_link")
  @@index([code], map: "idx_sytex_form_link_code")
  @@map("sytex_form_links")
}

model sytex_site_maintenance {
  id         String   @id @default(uuid()) @db.Uuid
  importId   String   @map("import_id") @db.Uuid
  siteCode   String   @map("site_code")
  kind       String
  lastDate   DateTime @map("last_date") @db.Date
  formCode   String   @map("form_code")
  reportedAt String   @map("reported_at")
  import     sytex_supply_imports @relation(fields: [importId], references: [id], onDelete: Cascade, map: "fk_sytex_site_maintenance_import")
  @@unique([importId, siteCode, kind, formCode], map: "uq_sytex_site_maintenance")
  @@index([siteCode, kind], map: "idx_sytex_site_maintenance_site")
  @@map("sytex_site_maintenance")
}

model sytex_supply_import_items {
  id               String    @id @default(uuid()) @db.Uuid
  importId         String    @map("import_id") @db.Uuid
  formulario       String
  grupo            String
  indice           String
  description      String?
  quantity         Decimal?  @db.Decimal(18, 3)
  provider         String?
  siteCode         String?   @map("site_code")
  siteName         String?   @map("site_name")
  status           String?
  image            String?
  imageDeclared    Boolean   @default(false) @map("image_declared")
  lastEditedBy     String?   @map("last_edited_by")
  sourceEditedAt   String?   @map("source_edited_at")
  sourceAnswers    Json      @map("source_answers")
  import           sytex_supply_imports @relation(fields: [importId], references: [id], onDelete: Cascade, map: "fk_sytex_supply_items_import")

  @@unique([importId, formulario, grupo, indice], map: "uq_sytex_supply_import_item")
  @@index([formulario], map: "idx_sytex_supply_import_items_form")
  @@map("sytex_supply_import_items")
}

model supply_invoices {
  id String @id @default(uuid()) @db.Uuid
  requestKey String @unique @map("request_key") @db.Uuid
  requestHash String @map("request_hash") @db.VarChar(64)
  supplier String
  supplierKey String @map("supplier_key")
  documentType String @map("document_type")
  number String
  numberKey String @map("number_key")
  invoiceDate DateTime @map("invoice_date") @db.Date
  amount Decimal @db.Decimal(18, 2)
  currency String @db.VarChar(3)
  mendelTransactionId String? @map("mendel_transaction_id") @db.VarChar(80)
  downloadedAt DateTime? @map("downloaded_at") @db.Timestamptz(6)
  uploadedAt DateTime? @map("uploaded_at") @db.Timestamptz(6)
  intraReference String? @map("intra_reference")
  version Int @default(0)
  createdBy String @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  lines supply_invoice_lines[]
  attachments supply_invoice_attachments[]
  events supply_invoice_events[]
  @@unique([supplierKey, documentType, numberKey], map: "uq_supply_invoice_identity")
  @@index([createdAt], map: "idx_supply_invoice_date")
}

model supply_invoice_lines {
  id String @id @default(uuid()) @db.Uuid
  invoiceId String @map("invoice_id") @db.Uuid
  position Int
  description String
  quantity Decimal @db.Decimal(18, 3)
  availableQuantity Decimal @map("available_quantity") @db.Decimal(18, 3)
  unit String
  version Int @default(0)
  invoice supply_invoices @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  handoffs supply_handoffs[]
  @@unique([invoiceId, position], map: "uq_supply_invoice_line")
}

model supply_invoice_attachments {
  id String @id @default(uuid()) @db.Uuid
  invoiceId String @map("invoice_id") @db.Uuid
  fileName String @map("file_name")
  mimeType String @map("mime_type")
  byteCount Int @map("byte_count")
  fileHash String @map("file_hash") @db.VarChar(64)
  content Bytes @db.ByteA
  removedAt DateTime? @map("removed_at") @db.Timestamptz(6)
  createdBy String @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  invoice supply_invoices @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  @@unique([invoiceId, fileHash], map: "uq_supply_invoice_file")
}

model supply_invoice_events {
  id String @id @default(uuid()) @db.Uuid
  invoiceId String @map("invoice_id") @db.Uuid
  type String
  detail Json
  actorId String @map("actor_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  invoice supply_invoices @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  @@index([invoiceId, createdAt], map: "idx_supply_invoice_event")
}

model supply_handoffs {
  id String @id @default(uuid()) @db.Uuid
  lineId String @map("line_id") @db.Uuid
  requestKey String @map("request_key") @db.Uuid
  requestHash String @map("request_hash") @db.VarChar(64)
  technician String
  site String?
  quantityGiven Decimal @map("quantity_given") @db.Decimal(18, 3)
  remaining Decimal @db.Decimal(18, 3)
  assignedAt DateTime @map("assigned_at") @db.Timestamptz(6)
  dueAt DateTime @map("due_at") @db.Timestamptz(6)
  status String @default("ACTIVE")
  version Int @default(0)
  createdBy String @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  line supply_invoice_lines @relation(fields: [lineId], references: [id], onDelete: Restrict)
  movements supply_movements[]
  @@unique([lineId, requestKey], map: "uq_supply_handoff_request")
  @@index([status, dueAt], map: "idx_supply_handoff_due")
}

model supply_movements {
  id String @id @default(uuid()) @db.Uuid
  handoffId String @map("handoff_id") @db.Uuid
  requestKey String @map("request_key") @db.Uuid
  requestHash String @map("request_hash") @db.VarChar(64)
  type String
  quantity Decimal @db.Decimal(18, 3)
  notes String?
  usedAt DateTime @map("used_at") @db.Timestamptz(6)
  actorId String @map("actor_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  reversalOf String? @unique @map("reversal_of") @db.Uuid
  original supply_movements? @relation("SupplyReversal", fields: [reversalOf], references: [id], onDelete: Restrict)
  reversedBy supply_movements? @relation("SupplyReversal")
  handoff supply_handoffs @relation(fields: [handoffId], references: [id], onDelete: Restrict)
  allocations supply_consumption_forms[]
  @@unique([handoffId, requestKey], map: "uq_supply_movement_request")
  @@index([handoffId, createdAt], map: "idx_supply_movement_history")
}

model supply_consumption_forms {
  id String @id @default(uuid()) @db.Uuid
  movementId String @map("movement_id") @db.Uuid
  formCode String @map("form_code") @db.VarChar(20)
  quantity Decimal @db.Decimal(18, 3)
  verification String
  movement supply_movements @relation(fields: [movementId], references: [id], onDelete: Restrict)
  @@unique([movementId, formCode], map: "uq_supply_consumption_form")
  @@index([formCode], map: "idx_supply_consumption_form")
}

model correctivos {
  id                              BigInt    @id @default(autoincrement())
  codigo                          String    @unique
  codigo_remoto                   String?
  nombre                          String?
  descripcion                     String?
  plantilla                       String?
  proyecto                        String?
  tarea                           String?
  estado                          String?
  cliente                         String?
  elemento_red                    String?
  codigos_sitios_afectados        String?
  nombres_sitios_afectados        String?
  atributos                       String?
  solicitado_por                  String?
  contratista_asignado            String?
  usuarios_responsables_proveedor String?
  asignado_a                      String?
  usuario_colaborador             String?
  revisado_por                    String?
  notas                           String?
  fecha_plan                      DateTime? @db.Timestamptz(6)
  creado_el                       DateTime? @db.Timestamptz(6)
  abierto_el                      DateTime? @db.Timestamptz(6)
  en_proceso_el                   DateTime? @db.Timestamptz(6)
  en_revision_el                  DateTime? @db.Timestamptz(6)
  enviado_el                      DateTime? @db.Timestamptz(6)
  rechazado_el                    DateTime? @db.Timestamptz(6)
  comentarios_rechazo             String?
  tipo_rechazo                    String?
  cantidad_rechazos               Int?
  respuestas_rechazadas           String?
  cancelado_el                    DateTime? @db.Timestamptz(6)
  comentarios_cancelacion         String?
  aprobado_con_pendientes_el      DateTime? @db.Timestamptz(6)
  aprobado_con_pendientes_por     String?
  aprobado_el                     DateTime? @db.Timestamptz(6)
  comentarios_aprobacion          String?
  aprobado_por                    String?
  enlace                          String?
  sytex_tipo                      String    @default("correctivo")
  sytex_proyecto_id               Int?
  sincronizado_el                 DateTime  @default(now()) @db.Timestamptz(6)
  raw_data                        Json      @default("{}")
  creado_bd                       DateTime  @default(now()) @db.Timestamptz(6)
  actualizado_bd                  DateTime  @default(now()) @db.Timestamptz(6)

  @@index([codigos_sitios_afectados], map: "idx_correctivos_codigo_sitio")
  @@index([estado], map: "idx_correctivos_estado")
  @@index([fecha_plan], map: "idx_correctivos_fecha_plan")
  @@index([proyecto], map: "idx_correctivos_proyecto")
}

model cotizaciones {
  id                       BigInt    @id @default(autoincrement())
  codigo                   String    @unique
  nombre                   String?
  tipo                     String?
  estado                   String?
  codigo_tarea             String?
  nombre_tarea             String?
  estado_tarea             String?
  proyecto                 String?
  subproyecto              String?
  elemento_red             String?
  nombre_elemento_red      String?
  codigo_sitio             String?
  nombre_sitio             String?
  divisa                   String?
  proveedor                String?
  presupuesto              Decimal?  @db.Decimal(18, 2)
  total                    Decimal?  @db.Decimal(18, 2)
  comentarios              String?
  creado_por               String?
  fecha_creacion           DateTime? @db.Timestamptz(6)
  aprobador                String?
  fecha_aprobacion         DateTime? @db.Timestamptz(6)
  fecha_rechazo            DateTime? @db.Timestamptz(6)
  comentarios_rechazo      String?
  fecha_procesada          DateTime? @db.Timestamptz(6)
  pasos_aprobacion_activos String?
  campos_adicionales       String?
  enlace                   String?
  sytex_tipo               String    @default("qo_correctivo")
  sytex_proyecto_id        Int?
  sincronizado_el          DateTime  @default(now()) @db.Timestamptz(6)
  raw_data                 Json      @default("{}")
  creado_bd                DateTime  @default(now()) @db.Timestamptz(6)
  actualizado_bd           DateTime  @default(now()) @db.Timestamptz(6)

  @@index([codigo_sitio], map: "idx_cotizaciones_codigo_sitio")
  @@index([codigo_tarea], map: "idx_cotizaciones_codigo_tarea")
  @@index([estado], map: "idx_cotizaciones_estado")
  @@index([fecha_creacion], map: "idx_cotizaciones_fecha_creacion")
}

model insumos {
  id                BigInt    @id @default(autoincrement())
  formulario        String
  codigo_sitio      String?
  nombre_sitio      String?
  elemento_red      String?
  estado            String?
  grupo             String?
  indice            String?
  cantidad          Decimal?  @db.Decimal(18, 3)
  descripcion       String?
  provisto_por      String?
  imagen            String?
  ultima_edicion_el DateTime? @db.Timestamptz(6)
  sincronizado_el   DateTime  @default(now()) @db.Timestamptz(6)
  raw_data          Json      @default("{}")
  creado_bd         DateTime  @default(now()) @db.Timestamptz(6)
  actualizado_bd    DateTime  @default(now()) @db.Timestamptz(6)

  @@unique([formulario, grupo, indice], map: "uq_insumo_sytex")
  @@index([codigo_sitio], map: "idx_insumos_codigo_sitio")
  @@index([descripcion], map: "idx_insumos_descripcion")
  @@index([formulario], map: "idx_insumos_formulario")
  @@index([provisto_por], map: "idx_insumos_provisto_por")
}

model preventivos {
  id                              BigInt    @id @default(autoincrement())
  codigo                          String    @unique
  nombre                          String?
  descripcion                     String?
  plantilla                       String?
  proyecto                        String?
  tarea                           String?
  estado                          String?
  elemento_red                    String?
  codigos_sitios_afectados        String?
  nombres_sitios_afectados        String?
  atributos                       String?
  solicitado_por                  String?
  contratista_asignado            String?
  usuarios_responsables_proveedor String?
  asignado_a                      String?
  usuario_colaborador             String?
  revisado_por                    String?
  fecha_plan                      DateTime? @db.Timestamptz(6)
  creado_el                       DateTime? @db.Timestamptz(6)
  abierto_el                      DateTime? @db.Timestamptz(6)
  en_proceso_el                   DateTime? @db.Timestamptz(6)
  en_revision_el                  DateTime? @db.Timestamptz(6)
  enviado_el                      DateTime? @db.Timestamptz(6)
  aprobado_el                     DateTime? @db.Timestamptz(6)
