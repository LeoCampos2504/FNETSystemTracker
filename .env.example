NEXT_PUBLIC_USE_MOCK_API=false
DATABASE_URL=
AUTH_SECRET=
# Solo para ejecutar npm run auth:bootstrap-admin; retirar después de crear el Admin.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Administradora FNET
# Sincronización directa con Sytex (opcional). Usuario y clave generada en el perfil de Sytex;
# cargarlos solo como variables del servicio. SYTEX_AUTHORIZATION, si se define, reemplaza a ambos
# con el valor completo del encabezado Authorization.
SYTEX_USER=
SYTEX_API_KEY=
SYTEX_AUTHORIZATION=
SYTEX_BASE_URL=https://claro.sytex.io
SYTEX_ORGANIZATION_ID=1
