NEXT_PUBLIC_USE_MOCK_API=true

# Which BackendRepositories implementation the backend composition root
# (src/server/container.ts) uses: "memory" (default, no DB needed — this is
# what the unit test suite always runs against) or "prisma" (real
# PostgreSQL, requires DATABASE_URL below). Unset = memory. Any other value
# fails fast at startup. See docs/BACKEND_PRISMA_INTEGRATION.md.
FNET_REPOSITORY_PROVIDER=memory

# Local prototype: run `npx prisma dev` (bundled with Prisma 7, no Docker
# needed) and paste the DATABASE_URL/SHADOW_DATABASE_URL it prints below.
# Production: point these at a real PostgreSQL instance — the schema and
# repositories don't change either way. Only needed when
# FNET_REPOSITORY_PROVIDER=prisma. See docs/DATABASE.md.
DATABASE_URL=
SHADOW_DATABASE_URL=

AUTH_SECRET=
